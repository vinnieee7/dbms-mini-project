# BreachVault Environment Variables
# Relational Database Configuration (PostgreSQL / MySQL)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=BreachVault
DB_USER=root
DB_PASSWORD=your_password_here

# PostgreSQL / pgvector Configuration (Optional alternative)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=breachvault
# PG_USER=postgres
# PG_PASSWORD=postgres

# Vector Search Model Configuration
VECTOR_DIMENSION=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Next.js Application
NEXT_PUBLIC_APP_NAME="BreachVault"
NEXT_PUBLIC_APP_VERSION="1.0.0"

